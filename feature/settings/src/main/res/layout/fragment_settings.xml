<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/walklog_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingBottom="20dp"
            android:text="@string/settings_title"
            android:textColor="@color/walklog_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_card"
            style="@style/WalkLogSettingsCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="@color/walklog_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="K" />

            <TextView
                android:id="@+id/tv_nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/walklog_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_edit_hint"
                app:layout_constraintEnd_toStartOf="@id/tv_points_badge"
                app:layout_constraintStart_toEndOf="@id/tv_avatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="닉네임" />

            <TextView
                android:id="@+id/tv_edit_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/ic_edit"
                android:gravity="center_vertical"
                android:text="@string/settings_edit_nickname"
                android:textColor="@color/walklog_text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_points_badge"
                app:layout_constraintStart_toEndOf="@id/tv_avatar"
                app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

            <TextView
                android:id="@+id/tv_points_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_points_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/walklog_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1,234 P" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Google 계정 카드 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/google_account_card"
            style="@style/WalkLogSettingsCard"
            android:layout_marginTop="12dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_card">

            <TextView
                android:id="@+id/tv_google_account_label"
                style="@style/WalkLogSettingsSectionLabel"
                android:layout_width="0dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="0dp"
                android:text="@string/settings_section_account"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 로그인 상태: 이메일 + 로그아웃 버튼 -->
            <TextView
                android:id="@+id/tv_google_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/walklog_text_primary"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_sign_out"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_google_account_label"
                tools:text="user@gmail.com"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_out"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/settings_sign_out"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_google_account_label"
                tools:visibility="visible" />

            <!-- 비로그인 상태: Google 로그인 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google_sign_in"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/settings_google_sign_in"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_google_account_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_daily_step_goal_section"
            style="@style/WalkLogSettingsSectionLabel"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_step_goal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/google_account_card" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/daily_step_goal_card"
            style="@style/WalkLogSettingsCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_daily_step_goal_section">

            <TextView
                android:id="@+id/tv_daily_step_goal_title"
                style="@style/WalkLogSettingsPrimaryText"
                android:layout_width="0dp"
                android:text="@string/settings_daily_step_goal_title"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_daily_step_goal"
                app:layout_constraintEnd_toStartOf="@id/tv_daily_step_goal"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_daily_step_goal"
                style="@style/WalkLogSettingsValueTextPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="10,000 보" />

            <SeekBar
                android:id="@+id/seek_daily_step_goal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="30"
                android:progressTint="@color/walklog_primary"
                android:thumbTint="@color/walklog_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_daily_step_goal" />

            <TextView
                android:id="@+id/tv_daily_step_goal_min"
                style="@style/WalkLogSettingsRangeText"
                android:text="5,000"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seek_daily_step_goal" />

            <TextView
                android:id="@+id/tv_daily_step_goal_max"
                style="@style/WalkLogSettingsRangeText"
                android:text="20,000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seek_daily_step_goal" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_recovery_mission_section"
            style="@style/WalkLogSettingsSectionLabel"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_recovery_mission"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/daily_step_goal_card" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/recovery_mission_card"
            style="@style/WalkLogSettingsCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_recovery_mission_section">

            <TextView
                android:id="@+id/tv_recovery_mission_title"
                style="@style/WalkLogSettingsPrimaryText"
                android:layout_width="0dp"
                android:text="@string/settings_recovery_mission_title"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_recovery_mission_steps"
                app:layout_constraintEnd_toStartOf="@id/tv_recovery_mission_steps"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_recovery_mission_steps"
                style="@style/WalkLogSettingsValueTextSecondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="6,000 보" />

            <SeekBar
                android:id="@+id/seek_recovery_mission_steps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="14"
                android:progressTint="@color/walklog_secondary"
                android:thumbTint="@color/walklog_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_recovery_mission_steps" />

            <TextView
                android:id="@+id/tv_recovery_mission_min"
                style="@style/WalkLogSettingsRangeText"
                android:text="3,000"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seek_recovery_mission_steps" />

            <TextView
                android:id="@+id/tv_recovery_mission_max"
                style="@style/WalkLogSettingsRangeText"
                android:text="10,000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seek_recovery_mission_steps" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_notifications_section"
            style="@style/WalkLogSettingsSectionLabel"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recovery_mission_card" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/notifications_card"
            style="@style/WalkLogSettingsCard"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_notifications_section">

            <TextView
                android:id="@+id/tv_notifications_title"
                style="@style/WalkLogSettingsPrimaryText"
                android:layout_width="0dp"
                android:text="@string/settings_notifications_title"
                app:layout_constraintBottom_toTopOf="@id/tv_notifications_description"
                app:layout_constraintEnd_toStartOf="@id/switch_notifications"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tv_notifications_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_notifications_description"
                android:textColor="@color/walklog_text_secondary"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/switch_notifications"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_notifications_title" />

            <Switch
                android:id="@+id/switch_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_theme_section"
            style="@style/WalkLogSettingsSectionLabel"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_theme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notifications_card" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/theme_card"
            style="@style/WalkLogSettingsCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_theme_section">

            <TextView
                android:id="@+id/tv_theme_title"
                style="@style/WalkLogSettingsPrimaryText"
                android:text="@string/settings_theme_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_theme_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_theme_description"
                android:textColor="@color/walklog_text_secondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_theme_title" />

            <RadioButton
                android:id="@+id/radio_theme_system"
                style="@style/WalkLogSettingsRadioButton"
                android:layout_marginTop="10dp"
                android:text="@string/settings_theme_system"
                app:layout_constraintEnd_toStartOf="@id/radio_theme_light"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_theme_description" />

            <RadioButton
                android:id="@+id/radio_theme_light"
                style="@style/WalkLogSettingsRadioButton"
                android:text="@string/settings_theme_light"
                app:layout_constraintBaseline_toBaselineOf="@id/radio_theme_system"
                app:layout_constraintEnd_toStartOf="@id/radio_theme_dark"
                app:layout_constraintStart_toEndOf="@id/radio_theme_system" />

            <RadioButton
                android:id="@+id/radio_theme_dark"
                style="@style/WalkLogSettingsRadioButton"
                android:text="@string/settings_theme_dark"
                app:layout_constraintBaseline_toBaselineOf="@id/radio_theme_system"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/radio_theme_light" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_app_info_section"
            style="@style/WalkLogSettingsSectionLabel"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_app_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/theme_card" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_oss_licenses"
            style="@style/WalkLogSettingsCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_app_info_section">

            <TextView
                android:id="@+id/tv_oss_licenses_title"
                style="@style/WalkLogSettingsPrimaryText"
                android:layout_width="0dp"
                android:text="@string/settings_oss_licenses"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_oss_licenses_arrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_oss_licenses_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/walklog_text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="WalkLog v1.0.0"
            android:textColor="@color/walklog_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_oss_licenses" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
